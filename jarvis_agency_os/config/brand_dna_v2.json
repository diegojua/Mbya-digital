{
  "composition": {
    "alignment": "left",
    "negative_space": "high",
    "visual_density": "low",
    "hero_ratio": "60_40",
    "grid_columns_desktop": 12,
    "max_content_width": "1200px",
    "section_padding": "120px"
  },
  "typography": {
    "font_primary": "Outfit",
    "font_editorial": "Cormorant Garamond",
    "headline_weight": 900,
    "headline_tracking_px": -2,
    "headline_case": "sentence",
    "headline_max_chars": 60,
    "headline_line_height": 1.1,
    "subheadline_weight": 300,
    "subheadline_max_chars": 120,
    "body_weight": 500,
    "body_opacity": 0.72,
    "body_line_height": 1.6,
    "cta_weight": 900,
    "cta_max_chars": 25,
    "cta_case": "uppercase",
    "cta_letter_spacing": "0.5px"
  },
  "image_behavior": {
    "crop": "cover",
    "border_radius": "30px",
    "depth_overlay": true,
    "overlay_gradient": "linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.6) 100%)"
  },
  "spacing": {
    "micro": "8px",
    "small": "16px",
    "medium": "24px",
    "large": "40px",
    "xl": "80px",
    "xxl": "120px"
  },
  "interactive": {
    "border_radius_pill": "50px",
    "border_radius_card": "28px",
    "transition_default": "all 0.4s cubic-bezier(0.25, 1, 0.5, 1)",
    "transition_elastic": "all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)",
    "hover_translate_y": "-8px",
    "shadow_card": "0 15px 35px rgba(0,0,0,0.08)",
    "shadow_cta": "0 10px 30px"
  }
}
