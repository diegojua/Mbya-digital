#!/usr/bin/env python3
"""
CLI local do JarvisAgency OS.

Uso rapido:
  ./jarvisagency test
  ./jarvisagency advocacia
  ./jarvisagency amar
  ./jarvisagency design-brief --nicho "educação infantil" --cliente "Amar"
  ./jarvisagency pipeline "Cliente" "Objetivo" --nicho "advocacia" --formatos feed,story
  ./jarvisagency pipeline "Amar" "conversão" --nicho "educação infantil" --formatos feed,story,carrossel
  ./jarvisagency qa caminho/arte.html
  ./jarvisagency feedback --file caminho/arte.html --label approved
  ./jarvisagency campanha "Cliente" "Objetivo" --nicho "odonto"
  ./jarvisagency server
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(PROJECT_ROOT))
os.chdir(PROJECT_ROOT)


def _print_result(result) -> None:
    if isinstance(result, (dict, list)):
        print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
        return

    if hasattr(result, "__iter__") and not isinstance(result, (str, bytes)):
        for chunk in result:
            print(chunk)
        return

    print(result)


def cmd_test(_args: argparse.Namespace) -> int:
    return subprocess.call([sys.executable, str(PROJECT_ROOT / "test_mcp_server.py")])


def cmd_server(_args: argparse.Namespace) -> int:
    print("[JarvisAgency] Subindo servidor MCP em STDIO...")
    return subprocess.call([sys.executable, str(PROJECT_ROOT / "mcp_agent_agency.py")])


def cmd_pipeline(args: argparse.Namespace) -> int:
    from mcp_agent_agency import executar_pipeline_completo_saas

    result = executar_pipeline_completo_saas(
        nome_cliente=args.cliente,
        objetivo=args.objetivo,
        nicho=args.nicho,
        formatos=args.formatos,
    )
    _print_result(result)
    return 0


def cmd_campanha(args: argparse.Namespace) -> int:
    from mcp_agent_agency import rodar_campanha_completa

    result = rodar_campanha_completa(
        nome_cliente=args.cliente,
        objetivo=args.objetivo,
        nicho=args.nicho,
    )
    _print_result(result)
    return 0


def cmd_advocacia(_args: argparse.Namespace) -> int:
    from gerar_ad_advocacia_premium import executar

    _print_result(executar())
    return 0


def cmd_amar(_args: argparse.Namespace) -> int:
    from gerar_ad_amar_pedagogico import executar

    _print_result(executar())
    return 0


def cmd_design_brief(args: argparse.Namespace) -> int:
    from jarvis_agency_os.design_intelligence import build_design_brief

    context = {
        "niche": args.nicho,
        "client_name": args.cliente,
        "objective": args.objetivo,
    }
    print(build_design_brief(context))
    return 0


def cmd_qa(args: argparse.Namespace) -> int:
    from jarvis_agency_os.visual_qa import evaluate_visual_quality

    result = evaluate_visual_quality({
        "file": args.arquivo,
        "headline": args.headline or "",
        "cta": args.cta or "",
        "format": args.formato,
    })
    _print_result(result)
    return 0 if result.get("status") != "fail" else 2


def cmd_feedback(args: argparse.Namespace) -> int:
    from jarvis_agency_os.visual_memory_v2 import get_memory

    approved = None
    if args.label in {"approved", "approve", "aprovado"}:
        approved = True
    elif args.label in {"rejected", "reject", "reprovado"}:
        approved = False

    result = get_memory().set_human_feedback(
        file_path=args.file,
        approved=approved,
        feedback_label=args.label,
        feedback_notes=args.notes,
    )
    _print_result(result)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="jarvisagency",
        description="CLI local para rodar o JarvisAgency OS e o servidor MCP.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_test = sub.add_parser("test", help="Valida imports e instancia do MCP.")
    p_test.set_defaults(func=cmd_test)

    p_server = sub.add_parser("server", help="Inicia o servidor MCP via STDIO.")
    p_server.set_defaults(func=cmd_server)

    p_adv = sub.add_parser("advocacia", help="Gera feed e story premium de advocacia.")
    p_adv.set_defaults(func=cmd_advocacia)

    p_amar = sub.add_parser("amar", help="Gera feed e story premium do Amar pedagógico.")
    p_amar.set_defaults(func=cmd_amar)

    p_design = sub.add_parser("design-brief", help="Gera briefing visual por nicho.")
    p_design.add_argument("--nicho", default="geral")
    p_design.add_argument("--cliente", default="Cliente")
    p_design.add_argument("--objetivo", default="conversão")
    p_design.set_defaults(func=cmd_design_brief)

    p_pipeline = sub.add_parser("pipeline", help="Executa o pipeline SaaS completo.")
    p_pipeline.add_argument("cliente")
    p_pipeline.add_argument("objetivo")
    p_pipeline.add_argument("--nicho", default="geral")
    p_pipeline.add_argument("--formatos", default="feed", help="Ex: feed,story,carrossel")
    p_pipeline.set_defaults(func=cmd_pipeline)

    p_campanha = sub.add_parser("campanha", help="Executa a campanha integrada.")
    p_campanha.add_argument("cliente")
    p_campanha.add_argument("objetivo")
    p_campanha.add_argument("--nicho", default="geral")
    p_campanha.set_defaults(func=cmd_campanha)

    p_qa = sub.add_parser("qa", help="Audita visualmente um HTML local.")
    p_qa.add_argument("arquivo")
    p_qa.add_argument("--headline", default="")
    p_qa.add_argument("--cta", default="")
    p_qa.add_argument("--formato", default="feed")
    p_qa.set_defaults(func=cmd_qa)

    p_feedback = sub.add_parser("feedback", help="Registra aprovação/reprovação humana.")
    p_feedback.add_argument("--file", required=True)
    p_feedback.add_argument("--label", required=True, help="approved, rejected, ajustado, etc.")
    p_feedback.add_argument("--notes", default="")
    p_feedback.set_defaults(func=cmd_feedback)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
