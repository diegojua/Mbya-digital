# JarvisAgency OS Configuration
# Copy this file to .env and fill in your actual values
# Last updated: 2026-05-19

# ═══════════════════════════════════════════════════════════════
# AI & LLM APIs
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-... # OpenAI API key for text generation
ANTHROPIC_API_KEY=sk-ant-... # Anthropic Claude API key

# ═══════════════════════════════════════════════════════════════
# Social Media & Ad Platforms
# ═══════════════════════════════════════════════════════════════
INSTAGRAM_ACCESS_TOKEN=IGAB... # Instagram business token for publishing
INSTAGRAM_ACCOUNT_ID=123456789 # Your Instagram business account ID
META_GRAPH_TOKEN=... # Meta Graph API token
FACEBOOK_BUSINESS_ACCOUNT_ID=... # Facebook Business Account ID
TELEGRAM_BOT_TOKEN=... # Telegram bot token for approvals
TELEGRAM_CHAT_ID=... # Telegram chat ID for notifications

# ═══════════════════════════════════════════════════════════════
# Storage & Media Sources
# ═══════════════════════════════════════════════════════════════
UNSPLASH_ACCESS_KEY=... # Unsplash API key for stock images
PEXELS_API_KEY=... # Pexels API key for video assets (optional)

# ═══════════════════════════════════════════════════════════════
# Paths & Environment
# ═══════════════════════════════════════════════════════════════
OPEN_DESIGN_PATH=/home/diego/Documentos/Mbya Digital/open-design
WORKSPACE_PATH=/home/diego/Documentos/Mbya Digital/workspace
ENVIRONMENT=development # development, staging, production
DEBUG=false
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR

# ═══════════════════════════════════════════════════════════════
# MCP Server Configuration
# ═══════════════════════════════════════════════════════════════
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=127.0.0.1
MCP_AUTH_TOKEN=... # Optional authentication token

# ═══════════════════════════════════════════════════════════════
# Browser Automation (Playwright)
# ═══════════════════════════════════════════════════════════════
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000 # milliseconds
PLAYWRIGHT_SLOWMO=0 # delay in ms between actions (0 for no delay)
